NODE_ENV=development
PORT=3000
DB_PATH=./data/hospital-ivrs.db

# Public origin Exotel will hit. In dev you can expose localhost via ngrok
# and put the ngrok URL here. In prod, put the real HTTPS domain.
PUBLIC_BASE_URL=http://localhost:3000

# Exotel credentials (Dashboard → Settings → API)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=

# Comma-separated allow-list of Exotel egress IPs. Leave blank in dev.
EXOTEL_ALLOWED_IPS=
